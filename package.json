{
  "name": "sjwh-admin-api",
  "version": "1.0.0",
  "description": "rest api for sjwh admin",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "ts-node-dev --respawn --pretty --transpile-only src/index.ts dev",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "prisma:draft": "prisma migrate dev --create-only --skip-seed",
    "prisma:apply": "prisma migrate dev --skip-seed",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:generate:watch": "prisma generate --watch",
    "prisma:seed": "prisma db seed --preview-feature",
    "prisma:studio": "prisma studio",
    "prisma:pull": "prisma db pull",
    "prisma:reset": "prisma migrate reset",
    "prisma:deploy": "prisma migrate deploy",
    "prepare": "husky install"
  },
  "author": "nhxv",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.5.2",
    "@types/multer": "^1.4.11",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "fraction.js": "^4.2.0",
    "http-errors": "^2.0.0",
    "joi": "^17.7.0",
    "jsonwebtoken": "^9.0.0",
    "luxon": "^3.1.1",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.12",
    "@types/express": "^4.17.14",
    "@types/http-errors": "^2.0.1",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/luxon": "^3.1.0",
    "@types/node": "^18.11.9",
    "husky": "^8.0.3",
    "prettier": "2.8.4",
    "prisma": "^5.5.2",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.8.4"
  }
}
