generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(32)
  accounts Account[]
}

model Account {
  id       Int    @id @default(autoincrement())
  username String @unique @db.VarChar(32)
  password String
  role_id  Int
  role     Role   @relation(fields: [role_id], references: [id])
}

model Product {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @unique @db.VarChar(255)
  discontinued          Boolean                @default(false)
  productBackorders     ProductBackorder[]
  productCustomerOrders ProductCustomerOrder[]
  productStock          ProductStock?
  productVendorOrders   ProductVendorOrder[]
}

model Vendor {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(255)
  address      String?
  phone        String?       @db.VarChar(20)
  email        String?       @db.VarChar(320)
  presentative String?       @db.VarChar(255)
  discontinued Boolean       @default(false)
  vendorOrders VendorOrder[]
}

model Customer {
  id             Int             @id @default(autoincrement())
  name           String          @unique @db.VarChar(255)
  address        String?
  phone          String?         @db.VarChar(20)
  email          String?         @db.VarChar(320)
  presentative   String?         @db.VarChar(255)
  discontinued   Boolean         @default(false)
  backorders     Backorder[]
  customerOrders CustomerOrder[]
}

model Vehicle {
  id            Int     @id @default(autoincrement())
  license_plate String  @unique @db.VarChar(20)
  nickname      String? @db.VarChar(255)
  volume        Int?
  available     Boolean @default(true)
  discontinued  Boolean @default(false)
}

model ProductStock {
  id                  Int                  @id @default(autoincrement())
  product_name        String               @unique @db.VarChar(255)
  quantity            Int                  @default(0)
  created_at          DateTime
  updated_at          DateTime?
  product             Product              @relation(fields: [product_name], references: [name], onDelete: Cascade)
  productStockChanges ProductStockChange[]
}

model ProductStockChangeHistory {
  id                       Int                      @id @default(autoincrement())
  created_at               DateTime
  reason                   String                   @db.VarChar(32)
  productStockChanges      ProductStockChange[]
  productStockChangeReason ProductStockChangeReason @relation(fields: [reason], references: [name])
}

model ProductStockChange {
  id                        Int                       @id @default(autoincrement())
  stock_id                  Int
  change_id                 Int
  quantity_change           Int
  productStockChangeHistory ProductStockChangeHistory @relation(fields: [change_id], references: [id], onDelete: Cascade)
  productStock              ProductStock              @relation(fields: [stock_id], references: [id], onDelete: Cascade)
}

model ProductStockChangeReason {
  id                          Int                         @id @default(autoincrement())
  name                        String                      @unique @db.VarChar(32)
  productStockChangeHistories ProductStockChangeHistory[]
}

// Vendor order
model VendorOrder {
  id                  Int                  @id @default(autoincrement())
  code                String               @unique @db.VarChar(20)
  vendor_name         String               @db.VarChar(255)
  vendor              Vendor               @relation(fields: [vendor_name], references: [name], onDelete: Cascade)
  status              String               @db.VarChar(32)
  orderStatus         OrderStatus          @relation(fields: [status], references: [name])
  created_at          DateTime
  updated_at          DateTime?
  expected_at         DateTime
  is_test             Boolean              @default(false)
  is_invoice          Boolean              @default(false)
  productVendorOrders ProductVendorOrder[]

  @@unique([code, is_invoice], name: "VendorOrderInvoice_key")
}

model ProductVendorOrder {
  id           Int         @id @default(autoincrement())
  product_name String      @db.VarChar(255)
  product      Product     @relation(fields: [product_name], references: [name], onDelete: Cascade)
  order_code   String      @db.VarChar(20)
  vendorOrder  VendorOrder @relation(fields: [order_code], references: [code], onDelete: Cascade)
  quantity     Int
  unit_price   Decimal
  created_at   DateTime
  updated_at   DateTime?

  @@unique([product_name, order_code], name: "ProductVendorOrder_product_name_order_code_key")
}

// Customer order
model CustomerOrder {
  id                    Int                    @id @default(autoincrement())
  code                  String                 @unique @db.VarChar(20)
  customer_name         String                 @db.VarChar(255)
  customer              Customer               @relation(fields: [customer_name], references: [name], onDelete: Cascade)
  status                String                 @db.VarChar(32)
  orderStatus           OrderStatus            @relation(fields: [status], references: [name])
  created_at            DateTime
  updated_at            DateTime?
  expected_at           DateTime
  is_test               Boolean                @default(false)
  is_invoice            Boolean                @default(false)
  productCustomerOrders ProductCustomerOrder[]

  @@unique([code, is_invoice], name: "CustomerOrderInvoice_key")
}

model ProductCustomerOrder {
  id            Int           @id @default(autoincrement())
  product_name  String        @db.VarChar(255)
  product       Product       @relation(fields: [product_name], references: [name], onDelete: Cascade)
  order_code    String        @db.VarChar(20)
  customerOrder CustomerOrder @relation(fields: [order_code], references: [code], onDelete: Cascade)
  quantity      Int
  unit_price    Decimal
  created_at    DateTime
  updated_at    DateTime?

  @@unique([product_name, order_code], name: "ProductCustomerOrder_product_name_order_code_key")
}

model OrderStatus {
  id             Int             @id @default(autoincrement())
  name           String          @unique @db.VarChar(32)
  customerOrders CustomerOrder[]
  vendorOrders   VendorOrder[]
}

// Backorder
model Backorder {
  id                Int                @id @default(autoincrement())
  customer_name     String             @db.VarChar(255)
  customer          Customer           @relation(fields: [customer_name], references: [name], onDelete: Cascade)
  created_at        DateTime
  updated_at        DateTime?
  expected_at       DateTime
  is_test           Boolean            @default(false)
  is_archived       Boolean            @default(false)
  productBackorders ProductBackorder[]

  @@unique([id, is_archived], name: "BackorderArchive_key")
}

model ProductBackorder {
  id           Int       @id @default(autoincrement())
  product_name String    @db.VarChar(255)
  product      Product   @relation(fields: [product_name], references: [name], onDelete: Cascade)
  backorder_id Int
  backorder    Backorder @relation(fields: [backorder_id], references: [id], onDelete: Cascade)
  quantity     Int
  unit_price   Decimal
  created_at   DateTime
  updated_at   DateTime?

  @@unique([product_name, backorder_id], name: "ProductBackorder_product_name_backorder_id_key")
}
