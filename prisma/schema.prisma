generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(32)
  accounts Account[]
}

model Account {
  id                 Int                @id @default(autoincrement())
  username           String             @unique @db.VarChar(32)
  password           String
  nickname           String?            @unique @db.VarChar(255)
  role_id            Int
  role               Role               @relation(fields: [role_id], references: [id])
  active             Boolean?
  orderTaskHistories OrderTaskHistory[]
  customerOrders     CustomerOrder[]
  backorders         Backorder[]
}

model Product {
  id                           Int                           @id @default(autoincrement())
  name                         String                        @unique @db.VarChar(255)
  discontinued                 Boolean                       @default(false)
  sell_price                   Decimal?
  location_name                String?                       @db.VarChar(20)
  location                     Location?                     @relation(fields: [location_name], references: [name])
  units                        Unit[]
  stock                        Stock?
  productBackorders            ProductBackorder[]
  productCustomerOrders        ProductCustomerOrder[]
  productVendorOrders          ProductVendorOrder[]
  productVendorReturns         ProductVendorReturn[]
  productCustomerReturns       ProductCustomerReturn[]
  productVendorReturnRemains   ProductVendorReturnRemain[]
  productCustomerReturnRemains ProductCustomerReturnRemain[]
  vendorProductTendencies      VendorProductTendency[]
  customerProductTendencies    CustomerProductTendency[]
}

model Vendor {
  id                      Int                     @id @default(autoincrement())
  name                    String                  @unique @db.VarChar(255)
  address                 String?
  phone                   String?                 @db.VarChar(20)
  email                   String?                 @db.VarChar(320)
  presentative            String?                 @db.VarChar(255)
  discontinued            Boolean                 @default(false)
  vendorOrders            VendorOrder[]
  vendorReturns           VendorReturn[]
  vendorReturnRemains     VendorReturnRemain[]
  vendorProductTendencies VendorProductTendency[]
}

model Customer {
  id                        Int                       @id @default(autoincrement())
  name                      String                    @unique @db.VarChar(255)
  address                   String?
  phone                     String?                   @db.VarChar(20)
  email                     String?                   @db.VarChar(320)
  presentative              String?                   @db.VarChar(255)
  discontinued              Boolean                   @default(false)
  backorders                Backorder[]
  customerOrders            CustomerOrder[]
  customerReturns           CustomerReturn[]
  customerReturnRemains     CustomerReturnRemain[]
  customerProductTendencies CustomerProductTendency[]
}

model Vehicle {
  id            Int     @id @default(autoincrement())
  license_plate String  @unique @db.VarChar(20)
  nickname      String? @db.VarChar(255)
  volume        Int?
  available     Boolean @default(true)
  discontinued  Boolean @default(false)
}

// Unit
model Unit {
  id                          Int                           @id @default(autoincrement())
  name                        String                        @db.VarChar(10)
  code                        String                        @unique @db.VarChar(21) // productId (10) + underscore (1) + unitName (10)
  product_name                String                        @db.VarChar(255)
  product                     Product                       @relation(fields: [product_name], references: [name], onDelete: Cascade)
  ratio                       String                        @db.VarChar(4)
  discontinued                Boolean
  productVendorOrder          ProductVendorOrder[]
  productCustomerOrder        ProductCustomerOrder[]
  productBackorder            ProductBackorder[]
  productVendorReturn         ProductVendorReturn[]
  productVendorReturnRemains  ProductVendorReturnRemain[]
  productCustomerReturn       ProductCustomerReturn[]
  productCustomerRemainReturn ProductCustomerReturnRemain[]
  pendorProductTendency       VendorProductTendency[]
  customerProductTendency     CustomerProductTendency[]

  @@unique([name, product_name], name: "ProductUnitStock_key")
}

model Stock {
  id           Int           @id @default(autoincrement())
  product_name String        @unique @db.VarChar(255)
  product      Product       @relation(fields: [product_name], references: [name], onDelete: Cascade)
  quantity     String        @db.VarChar(255)
  created_at   DateTime
  updated_at   DateTime
  stockChanges StockChange[]
}

model StockChangeHistory {
  id                Int               @id @default(autoincrement())
  created_at        DateTime
  reason            String            @db.VarChar(32)
  stockChangeReason StockChangeReason @relation(fields: [reason], references: [name])
  order_code        String?           @db.VarChar(20)
  stockChanges      StockChange[]

  @@unique([reason, order_code], name: "OrderStockChangeHistory_key")
}

model StockChange {
  id                 Int                @id @default(autoincrement())
  stock_id           Int
  stock              Stock              @relation(fields: [stock_id], references: [id], onDelete: Cascade)
  change_id          Int
  stockChangeHistory StockChangeHistory @relation(fields: [change_id], references: [id], onDelete: Cascade)
  quantity_change    String
}

model StockChangeReason {
  id                   Int                  @id @default(autoincrement())
  name                 String               @unique @db.VarChar(32)
  stockChangeHistories StockChangeHistory[]
}

model Location {
  id      Int       @id @default(autoincrement())
  name    String    @unique @db.VarChar(20)
  product Product[]
}

// Vendor order
model VendorOrder {
  id                  Int                  @id @default(autoincrement())
  code                String               @unique @db.VarChar(20)
  vendor_name         String               @db.VarChar(255)
  vendor              Vendor               @relation(fields: [vendor_name], references: [name], onDelete: Cascade)
  status              String               @db.VarChar(32)
  orderStatus         OrderStatus          @relation(fields: [status], references: [name])
  created_at          DateTime
  updated_at          DateTime
  expected_at         DateTime
  is_test             Boolean              @default(false)
  is_sold             Boolean              @default(false)
  productVendorOrders ProductVendorOrder[]
  vendorReturns       VendorReturn[]
  vendorReturnRemain  VendorReturnRemain?

  @@unique([code, is_sold], name: "VendorOrderSold_key")
}

model ProductVendorOrder {
  id           Int         @id @default(autoincrement())
  product_name String      @db.VarChar(255)
  product      Product     @relation(fields: [product_name], references: [name], onDelete: Cascade)
  order_code   String      @db.VarChar(20)
  vendorOrder  VendorOrder @relation(fields: [order_code], references: [code], onDelete: Cascade)
  quantity     Int
  unit_code    String      @db.VarChar(21)
  unit         Unit        @relation(fields: [unit_code], references: [code], onDelete: Cascade)
  unit_price   Decimal
  created_at   DateTime
  updated_at   DateTime

  @@unique([product_name, order_code], name: "ProductVendorOrder_key")
}

// Customer order
model CustomerOrder {
  id                    Int                    @id @default(autoincrement())
  code                  String                 @unique @db.VarChar(20)
  customer_name         String                 @db.VarChar(255)
  customer              Customer               @relation(fields: [customer_name], references: [name], onDelete: Cascade)
  status                String                 @db.VarChar(32)
  orderStatus           OrderStatus            @relation(fields: [status], references: [name])
  created_at            DateTime
  updated_at            DateTime
  expected_at           DateTime
  is_test               Boolean                @default(false)
  is_sold               Boolean                @default(false)
  assign_to             String                 @db.VarChar(32)
  account               Account                @relation(fields: [assign_to], references: [nickname])
  priority              Int
  is_doing              Boolean                @default(false)
  manual_code           String?                @unique @db.VarChar(6)
  payment_code          String?                @unique @db.VarChar(20)
  note                  String?                @db.VarChar(128)
  customerPayment       CustomerPayment?       @relation(fields: [payment_code], references: [code])
  productCustomerOrders ProductCustomerOrder[]
  customerReturns       CustomerReturn[]
  customerReturnRemains CustomerReturnRemain?
  orderTaskHistories    OrderTaskHistory[]

  @@unique([code, is_sold], name: "CustomerOrderSold_key")
  @@unique([assign_to, priority, created_at], name: "CustomerOrderPriority_key")
}

model ProductCustomerOrder {
  id            Int           @id @default(autoincrement())
  product_name  String        @db.VarChar(255)
  product       Product       @relation(fields: [product_name], references: [name], onDelete: Cascade)
  order_code    String        @db.VarChar(20)
  customerOrder CustomerOrder @relation(fields: [order_code], references: [code], onDelete: Cascade)
  quantity      Int
  unit_code     String        @db.VarChar(21)
  unit          Unit          @relation(fields: [unit_code], references: [code], onDelete: Cascade)
  unit_price    Decimal
  created_at    DateTime
  updated_at    DateTime

  @@unique([order_code, unit_code], name: "ProductCustomerOrder_key")
}

model OrderStatus {
  id             Int             @id @default(autoincrement())
  name           String          @unique @db.VarChar(32)
  customerOrders CustomerOrder[]
  vendorOrders   VendorOrder[]
}

// Backorder
model Backorder {
  id                Int                @id @default(autoincrement())
  customer_name     String             @db.VarChar(255)
  customer          Customer           @relation(fields: [customer_name], references: [name], onDelete: Cascade)
  created_at        DateTime
  updated_at        DateTime
  expected_at       DateTime
  is_test           Boolean            @default(false)
  is_archived       Boolean            @default(false)
  assign_to         String             @db.VarChar(32)
  account           Account            @relation(fields: [assign_to], references: [nickname])
  productBackorders ProductBackorder[]

  @@unique([id, is_archived], name: "BackorderArchive_key")
}

model ProductBackorder {
  id           Int       @id @default(autoincrement())
  product_name String    @db.VarChar(255)
  product      Product   @relation(fields: [product_name], references: [name], onDelete: Cascade)
  backorder_id Int
  backorder    Backorder @relation(fields: [backorder_id], references: [id], onDelete: Cascade)
  quantity     Int
  unit_code    String    @db.VarChar(21)
  unit         Unit      @relation(fields: [unit_code], references: [code], onDelete: Cascade)
  unit_price   Decimal
  created_at   DateTime
  updated_at   DateTime

  @@unique([product_name, backorder_id], name: "ProductBackorder_key")
}

// Vendor return
model VendorReturn {
  id                   Int                   @id @default(autoincrement())
  vendor_name          String                @db.VarChar(255)
  vendor               Vendor                @relation(fields: [vendor_name], references: [name], onDelete: Cascade)
  order_code           String                @db.VarChar(20)
  vendorOrder          VendorOrder           @relation(fields: [order_code], references: [code], onDelete: Cascade)
  created_at           DateTime
  refund               Decimal
  productVendorReturns ProductVendorReturn[]
}

model ProductVendorReturn {
  id           Int          @id @default(autoincrement())
  product_name String       @db.VarChar(255)
  product      Product      @relation(fields: [product_name], references: [name], onDelete: Cascade)
  return_id    Int
  vendorReturn VendorReturn @relation(fields: [return_id], references: [id], onDelete: Cascade)
  quantity     Int
  unit_code    String       @db.VarChar(21)
  unit         Unit         @relation(fields: [unit_code], references: [code], onDelete: Cascade)
  created_at   DateTime
}

// each vendor order only has 1 vendor return remain - but multiple vendor returns
model VendorReturnRemain {
  id                         Int                         @id @default(autoincrement())
  order_code                 String                      @unique @db.VarChar(20)
  vendorOrder                VendorOrder                 @relation(fields: [order_code], references: [code], onDelete: Cascade)
  vendor_name                String                      @db.VarChar(255)
  vendor                     Vendor                      @relation(fields: [vendor_name], references: [name], onDelete: Cascade)
  sold_at                    DateTime
  productVendorReturnRemains ProductVendorReturnRemain[]
}

model ProductVendorReturnRemain {
  id                        Int                @id @default(autoincrement())
  vendor_return_remain_code String             @db.VarChar(20)
  vendorReturnRemain        VendorReturnRemain @relation(fields: [vendor_return_remain_code], references: [order_code], onDelete: Cascade)
  product_name              String             @db.VarChar(255)
  product                   Product            @relation(fields: [product_name], references: [name], onDelete: Cascade)
  quantity                  String
  unit_code                 String             @db.VarChar(21)
  unit                      Unit               @relation(fields: [unit_code], references: [code], onDelete: Cascade)
  unit_price                Decimal

  @@unique([vendor_return_remain_code, product_name], name: "ProductVendorReturnRemain_key")
}

// Customer return
model CustomerReturn {
  id                     Int                     @id @default(autoincrement())
  customer_name          String                  @db.VarChar(255)
  customer               Customer                @relation(fields: [customer_name], references: [name], onDelete: Cascade)
  order_code             String                  @db.VarChar(20)
  customerOrder          CustomerOrder           @relation(fields: [order_code], references: [code], onDelete: Cascade)
  created_at             DateTime
  refund                 Decimal
  productCustomerReturns ProductCustomerReturn[]
}

model ProductCustomerReturn {
  id             Int            @id @default(autoincrement())
  product_name   String         @db.VarChar(255)
  product        Product        @relation(fields: [product_name], references: [name], onDelete: Cascade)
  return_id      Int
  customerReturn CustomerReturn @relation(fields: [return_id], references: [id], onDelete: Cascade)
  quantity       Int
  unit_code      String         @db.VarChar(21)
  unit           Unit           @relation(fields: [unit_code], references: [code], onDelete: Cascade)
  created_at     DateTime

  @@unique([return_id, unit_code], name: "ProductCustomerReturn_key")
}

model CustomerReturnRemain {
  id                           Int                           @id @default(autoincrement())
  order_code                   String                        @unique @db.VarChar(20)
  customerOrder                CustomerOrder                 @relation(fields: [order_code], references: [code], onDelete: Cascade)
  customer_name                String                        @db.VarChar(255)
  customer                     Customer                      @relation(fields: [customer_name], references: [name], onDelete: Cascade)
  sold_at                      DateTime
  order_manual_code            String?                       @unique @db.VarChar(6)
  productCustomerReturnRemains ProductCustomerReturnRemain[]
}

model ProductCustomerReturnRemain {
  id                          Int                  @id @default(autoincrement())
  customer_return_remain_code String               @db.VarChar(20)
  customerReturnRemain        CustomerReturnRemain @relation(fields: [customer_return_remain_code], references: [order_code], onDelete: Cascade)
  product_name                String               @db.VarChar(255)
  product                     Product              @relation(fields: [product_name], references: [name], onDelete: Cascade)
  quantity                    String
  unit_code                   String               @db.VarChar(21)
  unit                        Unit                 @relation(fields: [unit_code], references: [code], onDelete: Cascade)
  unit_price                  Decimal

  @@unique([customer_return_remain_code, unit_code], name: "ProductCustomerReturnRemain_key")
}

// Task history
model OrderTaskHistory {
  id            Int           @id @default(autoincrement())
  order_code    String        @db.VarChar(20)
  customerOrder CustomerOrder @relation(fields: [order_code], references: [code], onDelete: Cascade)
  employee_name String        @db.VarChar(255)
  account       Account       @relation(fields: [employee_name], references: [nickname], onDelete: Cascade)
  type          String        @db.VarChar(32)
  orderTaskType OrderTaskType @relation(fields: [type], references: [name])
  created_at    DateTime
  updated_at    DateTime

  @@unique([order_code, type], name: "OrderTask_key")
}

model OrderTaskType {
  id                 Int                @id @default(autoincrement())
  name               String             @unique @db.VarChar(32)
  orderTaskHistories OrderTaskHistory[]
}

// Tendency
model VendorProductTendency {
  id          Int     @id @default(autoincrement())
  vendor_name String  @db.VarChar(255)
  vendor      Vendor  @relation(fields: [vendor_name], references: [name], onDelete: Cascade)
  name        String  @db.VarChar(255)
  product     Product @relation(fields: [name], references: [name], onDelete: Cascade)
  quantity    Int
  unit_code   String  @db.VarChar(21)
  unit        Unit    @relation(fields: [unit_code], references: [code], onDelete: Cascade)

  @@unique([vendor_name, name], name: "VendorProductTendency_key")
}

model CustomerProductTendency {
  id            Int      @id @default(autoincrement())
  customer_name String   @db.VarChar(255)
  customer      Customer @relation(fields: [customer_name], references: [name], onDelete: Cascade)
  name          String   @db.VarChar(255)
  product       Product  @relation(fields: [name], references: [name], onDelete: Cascade)
  quantity      Int
  unit_code     String   @db.VarChar(21)
  unit          Unit     @relation(fields: [unit_code], references: [code], onDelete: Cascade)

  @@unique([customer_name, name], name: "CustomerProductTendency_key")
}

model CustomerPayment {
  id            Int            @unique @default(autoincrement())
  code          String         @unique @db.VarChar(20)
  status        String         @db.VarChar(32)
  paymentStatus PaymentStatus  @relation(fields: [status], references: [name], onDelete: Cascade)
  created_at    DateTime
  updated_at    DateTime
  customerOrder CustomerOrder?
}

model PaymentStatus {
  id               Int               @unique @default(autoincrement())
  name             String            @unique @db.VarChar(32)
  customerPayments CustomerPayment[]
}
