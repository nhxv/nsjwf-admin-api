generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id       Int       @id @default(autoincrement())
  name     String    @unique @db.VarChar(32)
  accounts Account[]
}

model Account {
  id       Int    @id @default(autoincrement())
  username String @unique @db.VarChar(32)
  password String
  role_id  Int
  role     Role   @relation(fields: [role_id], references: [id])
}

model Product {
  id                         Int                         @id @default(autoincrement())
  name                       String                      @unique @db.VarChar(255)
  discontinued               Boolean                     @default(false)
  productBackorders          ProductBackorder[]
  productCustomerOrders      ProductCustomerOrder[]
  productStock               ProductStock?
  productVendorOrders        ProductVendorOrder[]
  productVendorReturns       ProductVendorReturn[]
  productCustomerReturns     ProductCustomerReturn[]
  productVendorSaleReturns   ProductVendorSaleReturn[]
  productCustomerSaleReturns ProductCustomerSaleReturn[]
}

model Vendor {
  id                Int                @id @default(autoincrement())
  name              String             @unique @db.VarChar(255)
  address           String?
  phone             String?            @db.VarChar(20)
  email             String?            @db.VarChar(320)
  presentative      String?            @db.VarChar(255)
  discontinued      Boolean            @default(false)
  vendorOrders      VendorOrder[]
  vendorReturns     VendorReturn[]
  vendorSaleReturns VendorSaleReturn[]
}

model Customer {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique @db.VarChar(255)
  address             String?
  phone               String?              @db.VarChar(20)
  email               String?              @db.VarChar(320)
  presentative        String?              @db.VarChar(255)
  discontinued        Boolean              @default(false)
  backorders          Backorder[]
  customerOrders      CustomerOrder[]
  customerReturns     CustomerReturn[]
  customerSaleReturns CustomerSaleReturn[]
}

model Vehicle {
  id            Int     @id @default(autoincrement())
  license_plate String  @unique @db.VarChar(20)
  nickname      String? @db.VarChar(255)
  volume        Int?
  available     Boolean @default(true)
  discontinued  Boolean @default(false)
}

// Stock
model ProductStock {
  id                  Int                  @id @default(autoincrement())
  product_name        String               @unique @db.VarChar(255)
  product             Product              @relation(fields: [product_name], references: [name], onDelete: Cascade)
  quantity            Int                  @default(0)
  created_at          DateTime
  updated_at          DateTime
  productStockChanges ProductStockChange[]
}

model ProductStockChangeHistory {
  id                       Int                      @id @default(autoincrement())
  created_at               DateTime
  reason                   String                   @db.VarChar(32)
  productStockChangeReason ProductStockChangeReason @relation(fields: [reason], references: [name])
  productStockChanges      ProductStockChange[]
}

model ProductStockChange {
  id                        Int                       @id @default(autoincrement())
  stock_id                  Int
  productStock              ProductStock              @relation(fields: [stock_id], references: [id], onDelete: Cascade)
  change_id                 Int
  productStockChangeHistory ProductStockChangeHistory @relation(fields: [change_id], references: [id], onDelete: Cascade)
  quantity_change           Int
}

model ProductStockChangeReason {
  id                          Int                         @id @default(autoincrement())
  name                        String                      @unique @db.VarChar(32)
  productStockChangeHistories ProductStockChangeHistory[]
}

// Vendor order
model VendorOrder {
  id                  Int                  @id @default(autoincrement())
  code                String               @unique @db.VarChar(20)
  vendor_name         String               @db.VarChar(255)
  vendor              Vendor               @relation(fields: [vendor_name], references: [name], onDelete: Cascade)
  status              String               @db.VarChar(32)
  orderStatus         OrderStatus          @relation(fields: [status], references: [name])
  created_at          DateTime
  updated_at          DateTime
  expected_at         DateTime
  is_test             Boolean              @default(false)
  is_sold             Boolean              @default(false)
  productVendorOrders ProductVendorOrder[]
  vendorReturns       VendorReturn[]
  vendorSaleReturn    VendorSaleReturn?

  @@unique([code, is_sold], name: "VendorOrderSold_key")
}

model ProductVendorOrder {
  id           Int         @id @default(autoincrement())
  product_name String      @db.VarChar(255)
  product      Product     @relation(fields: [product_name], references: [name], onDelete: Cascade)
  order_code   String      @db.VarChar(20)
  vendorOrder  VendorOrder @relation(fields: [order_code], references: [code], onDelete: Cascade)
  quantity     Int
  unit_price   Decimal
  created_at   DateTime
  updated_at   DateTime

  @@unique([product_name, order_code], name: "ProductVendorOrder_key")
}

// Customer order
model CustomerOrder {
  id                    Int                    @id @default(autoincrement())
  code                  String                 @unique @db.VarChar(20)
  customer_name         String                 @db.VarChar(255)
  customer              Customer               @relation(fields: [customer_name], references: [name], onDelete: Cascade)
  status                String                 @db.VarChar(32)
  orderStatus           OrderStatus            @relation(fields: [status], references: [name])
  created_at            DateTime
  updated_at            DateTime
  expected_at           DateTime
  is_test               Boolean                @default(false)
  is_sold               Boolean                @default(false)
  productCustomerOrders ProductCustomerOrder[]
  customerReturns       CustomerReturn[]
  customerSaleReturn    CustomerSaleReturn?

  @@unique([code, is_sold], name: "CustomerOrderSold_key")
}

model ProductCustomerOrder {
  id            Int           @id @default(autoincrement())
  product_name  String        @db.VarChar(255)
  product       Product       @relation(fields: [product_name], references: [name], onDelete: Cascade)
  order_code    String        @db.VarChar(20)
  customerOrder CustomerOrder @relation(fields: [order_code], references: [code], onDelete: Cascade)
  quantity      Int
  unit_price    Decimal
  created_at    DateTime
  updated_at    DateTime

  @@unique([product_name, order_code], name: "ProductCustomerOrder_key")
}

model OrderStatus {
  id             Int             @id @default(autoincrement())
  name           String          @unique @db.VarChar(32)
  customerOrders CustomerOrder[]
  vendorOrders   VendorOrder[]
}

// Backorder
model Backorder {
  id                Int                @id @default(autoincrement())
  customer_name     String             @db.VarChar(255)
  customer          Customer           @relation(fields: [customer_name], references: [name], onDelete: Cascade)
  created_at        DateTime
  updated_at        DateTime
  expected_at       DateTime
  is_test           Boolean            @default(false)
  is_archived       Boolean            @default(false)
  productBackorders ProductBackorder[]

  @@unique([id, is_archived], name: "BackorderArchive_key")
}

model ProductBackorder {
  id           Int       @id @default(autoincrement())
  product_name String    @db.VarChar(255)
  product      Product   @relation(fields: [product_name], references: [name], onDelete: Cascade)
  backorder_id Int
  backorder    Backorder @relation(fields: [backorder_id], references: [id], onDelete: Cascade)
  quantity     Int
  unit_price   Decimal
  created_at   DateTime
  updated_at   DateTime

  @@unique([product_name, backorder_id], name: "ProductBackorder_key")
}

// Vendor return
model VendorReturn {
  id                   Int                   @id @default(autoincrement())
  vendor_name          String                @db.VarChar(255)
  vendor               Vendor                @relation(fields: [vendor_name], references: [name], onDelete: Cascade)
  order_code           String                @db.VarChar(20)
  vendorOrder          VendorOrder           @relation(fields: [order_code], references: [code], onDelete: Cascade)
  created_at           DateTime
  sale_off             Int
  productVendorReturns ProductVendorReturn[]
}

model ProductVendorReturn {
  id           Int          @id @default(autoincrement())
  product_name String       @db.VarChar(255)
  product      Product      @relation(fields: [product_name], references: [name], onDelete: Cascade)
  return_id    Int
  vendorReturn VendorReturn @relation(fields: [return_id], references: [id], onDelete: Cascade)
  quantity     Int
  unit_price   Decimal
  created_at   DateTime
}

model VendorSaleReturn {
  id                       Int                       @id @default(autoincrement())
  sale_code                String                    @unique @db.VarChar(20)
  vendorOrder              VendorOrder               @relation(fields: [sale_code], references: [code], onDelete: Cascade)
  vendor_name              String                    @db.VarChar(255)
  vendor                   Vendor                    @relation(fields: [vendor_name], references: [name], onDelete: Cascade)
  sold_at                  DateTime
  productVendorSaleReturns ProductVendorSaleReturn[]
}

model ProductVendorSaleReturn {
  id                      Int              @id @default(autoincrement())
  vendor_sale_return_code String           @db.VarChar(20)
  vendorSaleReturn        VendorSaleReturn @relation(fields: [vendor_sale_return_code], references: [sale_code], onDelete: Cascade)
  product_name            String           @db.VarChar(255)
  product                 Product          @relation(fields: [product_name], references: [name], onDelete: Cascade)
  quantity                Int
  unit_price              Decimal

  @@unique([vendor_sale_return_code, product_name], name: "ProductVendorSaleReturn_key")
}

// Customer return
model CustomerReturn {
  id                     Int                     @id @default(autoincrement())
  customer_name          String                  @db.VarChar(255)
  customer               Customer                @relation(fields: [customer_name], references: [name], onDelete: Cascade)
  order_code             String                  @db.VarChar(20)
  customerOrder          CustomerOrder           @relation(fields: [order_code], references: [code], onDelete: Cascade)
  created_at             DateTime
  sale_off               Int
  productCustomerReturns ProductCustomerReturn[]
}

model ProductCustomerReturn {
  id             Int            @id @default(autoincrement())
  product_name   String         @db.VarChar(255)
  product        Product        @relation(fields: [product_name], references: [name], onDelete: Cascade)
  return_id      Int
  customerReturn CustomerReturn @relation(fields: [return_id], references: [id], onDelete: Cascade)
  quantity       Int
  unit_price     Decimal
  created_at     DateTime
}

model CustomerSaleReturn {
  id                         Int                         @id @default(autoincrement())
  sale_code                  String                      @unique @db.VarChar(20)
  customerOrder              CustomerOrder               @relation(fields: [sale_code], references: [code], onDelete: Cascade)
  customer_name              String                      @db.VarChar(255)
  customer                   Customer                    @relation(fields: [customer_name], references: [name], onDelete: Cascade)
  sold_at                    DateTime
  productCustomerSaleReturns ProductCustomerSaleReturn[]
}

model ProductCustomerSaleReturn {
  id                        Int                @id @default(autoincrement())
  customer_sale_return_code String             @db.VarChar(20)
  customerSaleReturn        CustomerSaleReturn @relation(fields: [customer_sale_return_code], references: [sale_code], onDelete: Cascade)
  product_name              String             @db.VarChar(255)
  product                   Product            @relation(fields: [product_name], references: [name], onDelete: Cascade)
  quantity                  Int
  unit_price                Decimal

  @@unique([customer_sale_return_code, product_name], name: "ProductCustomerSaleReturn_key")
}
